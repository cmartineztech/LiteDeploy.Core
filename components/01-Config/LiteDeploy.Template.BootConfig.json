{
  "$schemaVersion": "1.0",
  "_Description": "Consolidated reference configurations for LiteDeploy deployment modes (BootWim, DeploymentShare, Media)",
  "Modes": {
    "BootWim": {
      "$schemaVersion": "1.0",
      "Metadata": {
        "Name": "LiteDeploy",
        "Environment": "Production",
        "Version": "1.0"
      },
      "Deployment": {
        "Type": "Network",
        "NetworkPath": "\\\\Server\\DeploymentShare$"
      },
      "_Comments": "Minimal Configuration for Boot.wim / PXE Boot"
    },
    "DeploymentShare": {
      "$schemaVersion": "1.0",
      "Metadata": {
        "Name": "LiteDeploy",
        "Environment": "Production",
        "Version": "1.0"
      },
      "Deployment": {
        "Type": "Network",
        "NetworkPath": "\\\\Server\\DeploymentShare$",
        "LocalRootName": "~LiteDeploy"
      },
      "Startup": {
        "SkipHardwarePreCheck": false,
        "SkipHardwareRequirments": false
      },
      "ComputerSetup": {
        "PromptForComputerName": true,
        "ComputerNamePrefix": null,
        "MaxComputerNameLength": 15,
        "PromptForComputerDescription": true,
        "Language": "en-US",
        "KeyboardLocale": "0409:00000409",
        "TimeZone": "Eastern Standard Time"
      },
      "Drivers": {
        "AutoDetectDrivers": true,
        "AllowManualSelection": true,
        "AutoOnlineDownloadOnMedia": true
      },
      "_Comments": "Configuration for Network Deployment Share"
    },
    "Media": {
      "$schemaVersion": "1.0",
      "Metadata": {
        "Name": "LiteDeploy",
        "Environment": "Production",
        "Version": "1.0"
      },
      "Deployment": {
        "Type": "Media",
        "NetworkPath": null,
        "LocalRootName": "~LiteDeploy"
      },
      "Startup": {
        "SkipHardwarePreCheck": false,
        "SkipHardwareRequirments": false
      },
      "ComputerSetup": {
        "PromptForComputerName": true,
        "ComputerNamePrefix": null,
        "MaxComputerNameLength": 15,
        "PromptForComputerDescription": true,
        "Language": "en-US",
        "KeyboardLocale": "0409:00000409",
        "TimeZone": "Eastern Standard Time"
      },
      "Drivers": {
        "AutoDetectDrivers": true,
        "AllowManualSelection": true,
        "AutoOnlineDownloadOnMedia": true
      },
      "_Comments": "Configuration for Standalone USB / ISO Media"
    }
  }
}