# Runtime log files
*.log

# Runtime WorkLogs directories, but keep the DeploymentShare template
WorkLogs/
**/WorkLogs/
!DeploymentShare/WorkLogs/
!DeploymentShare/WorkLogs/**

# Media and credential payloads
*.wim
*.esd
*.iso
localvault.bin
localseed.bin
Secrets.bin
**/Secrets/

# Local tooling
.vscode/

# Local-only / scratch (not part of the product tree)
/_Experiments/
/_TestFixtures/

# Repo DeploymentShare\Engine is a folder skeleton. Admin.Build publishes the flat
# scripts and Tools onto the live share (C:\DeploymentShare), not into this tree.
DeploymentShare/Engine/Runtime/**/*.ps1
DeploymentShare/Engine/Runtime/**/*.xaml
DeploymentShare/Engine/Runtime/**/*.cmd
DeploymentShare/Engine/Admin/**/*.ps1
DeploymentShare/Engine/Admin/**/*.xaml
DeploymentShare/Engine/Admin/**/*.cmd
DeploymentShare/Engine/Tools/**/*.ps1
DeploymentShare/Engine/Tools/**/*.md
DeploymentShare/Engine/Tools/**/LICENSE

# Accidental Admin.Build / Production-layout mirrors inside the git source tree.
# Editable source is numbered folders only (Runtime\000-Boot\, Admin\000-Build\, …).
# Flat LiteDeploy.*.ps1 (+ UI\) belong on DeploymentShare (or another publish root), not here.
/Engine/Runtime/LiteDeploy.*.ps1
/Engine/Runtime/LiteDeploy.DeploymentEngine.ps1
/Engine/Runtime/SetupComplete.cmd
/Engine/Runtime/UI/
/Engine/Admin/LiteDeploy.Admin.*.ps1
/Engine/Admin/UI/

# Bun WinPE experiment binaries staged on the share (rebuild via Publish-ToDeploymentShare.ps1)
DeploymentShare/Tools/BunWinPeSuite/**/*.exe
DeploymentShare/Tools/BunWinPeSuite/node_modules/
DeploymentShare/Tools/BunWinPeSuite/Results/
DeploymentShare/Tools/BunWinPeSuite/Catalogs/
DeploymentShare/Tools/BunWinPeSuite/CatalogWork/
DeploymentShare/Tools/BunWinPeSuite/Packs/
DeploymentShare/Tools/BunWinPeSuite/**/BunWinPeSuite.Results*.json
DeploymentShare/Tools/BunWinPeSuite/**/BunWinPeSuite.DownloadProbe.txt
